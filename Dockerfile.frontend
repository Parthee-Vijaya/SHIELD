# Multi-stage build for React Frontend
FROM node:18-alpine AS builder

WORKDIR /app

ARG REACT_APP_AUTH_MODE=development
ARG REACT_APP_ENTRA_TENANT_ID=
ARG REACT_APP_ENTRA_CLIENT_ID=
ARG REACT_APP_ENTRA_API_SCOPE=
ARG REACT_APP_ENTRA_REDIRECT_URI=
ENV REACT_APP_AUTH_MODE=${REACT_APP_AUTH_MODE}
ENV REACT_APP_ENTRA_TENANT_ID=${REACT_APP_ENTRA_TENANT_ID}
ENV REACT_APP_ENTRA_CLIENT_ID=${REACT_APP_ENTRA_CLIENT_ID}
ENV REACT_APP_ENTRA_API_SCOPE=${REACT_APP_ENTRA_API_SCOPE}
ENV REACT_APP_ENTRA_REDIRECT_URI=${REACT_APP_ENTRA_REDIRECT_URI}

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --prefer-offline --no-audit

# Copy frontend source
COPY frontend/ ./

# Build production bundle
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
