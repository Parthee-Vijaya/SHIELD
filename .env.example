# Database Configuration
# SQLite er standard for den lokale OrbStack-installation. Filen ligger i det
# persistente /app/data-volume i containeren og i ./data ved direkte lokal kørsel.
DATABASE_URL=sqlite:///./data/virkning.db

# PostgreSQL anbefales til en senere flerbrugerinstallation. Lokal dev-setup via brew:
#   brew install postgresql@16 && brew services start postgresql@16
#   /opt/homebrew/opt/postgresql@16/bin/psql -d postgres -c \\
#     "CREATE ROLE virkning WITH LOGIN PASSWORD 'local_dev'; \\
#      CREATE DATABASE virkning OWNER virkning;"
# Migration fra SQLite ved første-gang skift (brug host.docker.internal i
# DATABASE_URL når backend kører i Docker og PostgreSQL kører på værtsmaskinen):
#   DATABASE_URL=postgresql+psycopg2://virkning:local_dev@localhost/virkning \\
#     venv/bin/python scripts/migrate_sqlite_to_pg.py --reset
# DATABASE_URL=postgresql+psycopg2://virkning:local_dev@host.docker.internal:5432/virkning
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
SQL_ECHO=false

# LLM and Embedding Configuration
# v3 signal_extractor selection priority: LM Studio > Azure > OpenAI

# Option 1: LM Studio / Ollama / vLLM / any OpenAI-compatible local endpoint
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio          # default, usually unused
# LM_STUDIO_MODEL=local-model          # name shown in LM Studio
# LM_STUDIO_TIMEOUT=60                 # seconds
# LM_STUDIO_JSON_MODE=false            # set true for Ollama/servers with response_format support

# Option 2: Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your_key_here
# OPENAI_API_VERSION=2024-02-15-preview
# AZURE_DEPLOYMENT_NAME=gpt-4o-mini

# Option 3: Public OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Google Custom Search API (for research agent)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Backend
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
AI_CASES_RECIPIENT=
AI_CASES_CC=
AI_CASES_STORE=data/ai_cases.json

# ---- Microsoft Entra ID / roller ----
# Lokal OrbStack bruger en navngiven arbejdsidentitet uden Entra-signatur.
# Produktion fejler ved opstart, hvis APP_ENV=production uden AUTH_MODE=entra.
APP_ENV=development
AUTH_MODE=development
DEV_AUTH_USER=Lokal bruger
DEV_AUTH_ROLES=Hammeren.Sagsbehandler,Hammeren.Godkender,Hammeren.DPO,Hammeren.Admin

# Produktionsværdier fra to Entra-appregistreringer (SPA + beskyttet API):
# AUTH_MODE=entra
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# ENTRA_REQUIRED_SCOPE=access_as_user
# REACT_APP_AUTH_MODE=entra
# REACT_APP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# REACT_APP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# REACT_APP_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# REACT_APP_ENTRA_REDIRECT_URI=https://shield.kommune.dk

# SMTP (værdier skal udfyldes for at sende mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_REPLY_TO=

# Eksempel på frontend/backend base url hvis nødvendigt
# REACT_APP_API_BASE_URL=http://localhost:8000

# Caching Configuration
CACHE_DIR=.cache
CACHE_TTL=3600
ENABLE_CACHING=True

# ---- Server / Deploy ----
# API_HOST=0.0.0.0 binder til alle interfaces så Tailscale virker fra iPhone.
# Sæt til 127.0.0.1 hvis du KUN vil have lokal adgang.
API_HOST=127.0.0.1
API_PORT=8001
# API_RELOAD=true er udviklertilstand (auto-genstart ved kode-ændring).
# scripts/start_backend.sh sætter den til false uanset.
API_RELOAD=true

# Frontend port — bruges af scripts/start_frontend.sh
FRONTEND_PORT=8090

# ---- Observability ----
# TYR_LOG_DIR override default ~/Library/Logs/Tyr/
# TYR_LOG_DIR=/var/log/tyr
LOG_LEVEL=INFO

# ---- GDPR retention (Modul 1) ----
# Hvor længe persondata gemmes før auto-sletning. Bruges af det daglige
# retention-job kl. 02:00. Er en del af DPIA'en — kontakt jurist før ændring.
ASSESSMENT_LOG_RETENTION_DAYS=1825   # 5 år
CASE_RETENTION_DAYS=3650             # 10 år
DOCUMENT_RETENTION_DAYS=1825         # 5 år
RETENTION_ENABLED=true

# AI Gateway is configured only in the ignored root .env.local file.
# AI_GATEWAY_API_KEY must never use a REACT_APP_ prefix.
